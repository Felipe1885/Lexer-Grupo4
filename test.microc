/* Programa para experimentar palavras reservadas, operadores e comentarios. */
void mostrar(int x, bool ativo) {
    // Strings podem conter escapes e marcadores como // e /* sem comentar.
    if (ativo && x >= 0) {
        print("x = ", x, "\n");
    } else {
        print("// inativo");
    }
}

int main() {
    int valor = 42;
    mostrar(valor, true);
    return 0;
}
